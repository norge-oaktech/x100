# Supabase — from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER expose to the client. Used by the public
# onboarding write route to insert answers under RLS without a client session.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — not used yet in Phase 1, but reserved for Phase 2 (generation)
ANTHROPIC_API_KEY=

# Base URL of this app, used to build shareable onboarding links
NEXT_PUBLIC_APP_URL=http://localhost:3000
