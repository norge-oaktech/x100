# Supabase — from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER expose to the client. Used by the public
# onboarding write route to insert answers under RLS without a client session.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — used for asset generation
ANTHROPIC_API_KEY=

# Comma-separated list of emails allowed to approve/reject foundational
# documents (ICP, Brand Identity, Brand Guidelines, Messaging Framework,
# Case Studies, DDQ). Leave blank/unset to allow any signed-in team member
# to approve (current default). Example:
# APPROVER_EMAILS=you@company.com,jeff@company.com,pm2@company.com
APPROVER_EMAILS=

# Base URL of this app, used to build shareable onboarding links
NEXT_PUBLIC_APP_URL=http://localhost:3000
